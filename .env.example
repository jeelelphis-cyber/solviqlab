# ─────────────────────────────────────────────────────────────────────────────
# SolviqLAB — Environment Variables Template
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
# For production: add all variables to Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Analytics (public, safe to expose) ───────────────────────────────────────
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── LLM Providers (server-side only, NEVER use NEXT_PUBLIC_ prefix) ──────────
# Priority: DeepSeek → Anthropic → OpenAI → Mock (fallback, no key needed)

# DeepSeek — primary production model (deepseek-chat V3 / deepseek-reasoner R1)
# Pricing: ~$0.27/1M input, $1.10/1M output (V3)
# Dashboard: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=

# Anthropic — fallback provider (claude-haiku-4-5-20251001 default)
# Pricing: $0.25/1M input, $1.25/1M output (Haiku)
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — secondary fallback (gpt-4o-mini default)
# Pricing: $0.15/1M input, $0.60/1M output (4o-mini)
# Dashboard: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── HeyGen (server-side only) ─────────────────────────────────────────────────
# Video AI Coach generation — Epic 6
# Dashboard: https://app.heygen.com/settings/api
HEYGEN_API_KEY=

# ── Payments (server-side only) ───────────────────────────────────────────────
# Stripe — Premium subscription billing — Epic 7
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Database (when added) ─────────────────────────────────────────────────────
# Supabase / PlanetScale / Neon — Epic 8
DATABASE_URL=
